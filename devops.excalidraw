      "locked": false,
      "text": "Default Nginx configuration (on Ubuntu/Debian) points its root to :",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Default Nginx configuration (on Ubuntu/Debian) points its root to :",
