    {
      "id": "Mlmfhh_Cc7czwbBKCyh9M",
      "type": "text",
      "x": 18667.712275052036,
      "y": -46190.55184798363,
      "width": 880,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Il",
      "roundness": null,
      "seed": 660834909,
      "version": 345,
      "versionNonce": 883972573,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "When a user is created , it is automatically assigned with a group by default , \nwhich is usually same as the User ID . This group is called the Primary Group .\n\nIts a default group which will be present for every user .\n Every user can have exactly one primary Group .",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a user is created , it is automatically assigned with a group by default , \nwhich is usually same as the User ID . This group is called the Primary Group .\n\nIts a default group which will be present for every user .\n Every user can have exactly one primary Group .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
