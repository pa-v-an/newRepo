      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "ps aux\nps -> process status\na -> \"all users\" displays\nprocesses belonging to all\nusers\nu -> \"user-oriented format\"\nit provides detailed information\nabout each process in a user-friendly\nformat .\nx ->\"process without a controlling terminal\"\n(means background processes or startup \nprocesses that run independently without a \nspecific window or Interface)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ps aux\nps -> process status\na -> \"all users\" displays\nprocesses belonging to all\nusers\nu -> \"user-oriented format\"\nit provides detailed information\nabout each process in a user-friendly\nformat .\nx ->\"process without a controlling terminal\"\n(means background processes or startup \nprocesses that run independently without a \nspecific window or Interface)",
