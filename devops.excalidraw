    {
      "id": "41COEj8u6UWcqqggx7EYb",
      "type": "text",
      "x": 2900.0756099876435,
      "y": 60506.43770726949,
      "width": 1861.199951171875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
