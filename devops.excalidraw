      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "Ubuntu - Beginner and desktop friendly\nKali linux - ethical hacking and cyber security\nfedora - developers\nLinux Mint - windows users\nArch linux - highly customisable\nRHEL (Red Hat Enterprise Linux) - very stable , used in companies and organizations",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ubuntu - Beginner and desktop friendly\nKali linux - ethical hacking and cyber security\nfedora - developers\nLinux Mint - windows users\nArch linux - highly customisable\nRHEL (Red Hat Enterprise Linux) - very stable , used in companies and organizations",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
