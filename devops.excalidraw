      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Ln",
      "roundness": null,
      "seed": 564078813,
      "version": 1550,
      "versionNonce": 1372791069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "The 'metal' designation indicates that its a bare metal instance.\nThese instances offer the highest performance and lowest virtualization\noverhead by providing direct access to the underlying hardware , allowing\nfor a greater control and customization .. like running our own hypervisor .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The 'metal' designation indicates that its a bare metal instance.\nThese instances offer the highest performance and lowest virtualization\noverhead by providing direct access to the underlying hardware , allowing\nfor a greater control and customization .. like running our own hypervisor .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
