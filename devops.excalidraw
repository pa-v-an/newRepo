      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "A shell Script is a plain text file that contains a series of commands to be executed by the shell .\nIt helps in automating tasks such as \n                                    File Management\n                                    Program Execution\n                                    Text Processing\n                                    System administration tasks",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A shell Script is a plain text file that contains a series of commands to be executed by the shell .\nIt helps in automating tasks such as \n                                    File Management\n                                    Program Execution\n                                    Text Processing\n                                    System administration tasks",
