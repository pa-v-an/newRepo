      "link": null,
      "locked": false,
      "text": "That means whenever someone visits our server's port 80 , Nginx will serve files\nfrom this root location .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That means whenever someone visits our server's port 80 , Nginx will serve files\nfrom this root location .",
