      "seed": 1321228061,
      "version": 303,
      "versionNonce": 883103293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Groups are used to control access to files , folders and commands .\nInstead of giving permissions to each user one by one , we assign permission to a group ,\nand all users in that group inherits those permission",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Groups are used to control access to files , folders and commands .\nInstead of giving permissions to each user one by one , we assign permission to a group ,\nand all users in that group inherits those permission",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
