    {
      "id": "glKLF5Ni1apht0ZBckn5a",
      "type": "text",
      "x": -6852.85636470269,
      "y": -56385.40673852228,
      "width": 730.4000244140625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1971c2",
