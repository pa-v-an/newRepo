      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "git revert is used to undo changes form a previous commit by creating \na new commit that reverses or Inverses the effects of the target commit.\nunlike git reset (Which re -writes the history) , revert is \nnon - destructive and safe for repositories",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "git revert is used to undo changes form a previous commit by creating \na new commit that reverses or Inverses the effects of the target commit.\nunlike git reset (Which re -writes the history) , revert is \nnon - destructive and safe for repositories",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
