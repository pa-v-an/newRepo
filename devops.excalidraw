      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "It occurs when local branch and its corresponding remote\nbranch have different commit history.\nIn this case Git cannot reconcile these diverged branches\n(During push or pull)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It occurs when local branch and its corresponding remote\nbranch have different commit history.\nIn this case Git cannot reconcile these diverged branches\n(During push or pull)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
