      "link": null,
      "locked": false,
      "text": "// Changes the base of the feature branch to the latest \n   commit of the master branch",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Changes the base of the feature branch to the latest \n   commit of the master branch",
      "autoResize": true,
