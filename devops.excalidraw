    {
      "id": "vK8MpeziqAG9MgIAvp-J6",
      "type": "text",
      "x": 18491.61703695679,
      "y": -46358.60740353918,
      "width": 979,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
