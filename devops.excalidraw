      "versionNonce": 1734659859,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "1. Roles - Whoever is trying to access\n           In our scenario whi is trying to access EC2\n           We need to create a role for EC2",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Roles - Whoever is trying to access\n           In our scenario whi is trying to access EC2\n           We need to create a role for EC2",
