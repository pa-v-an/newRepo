    },
    {
      "id": "rdCgAnB6etEbvVHzDRDbG",
      "type": "text",
      "x": 2905.204842204621,
      "y": 42987.9071562211,
      "width": 1148.4000244140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Gs",
      "roundness": null,
      "seed": 1029254781,
      "version": 690,
      "versionNonce": 1327509139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "This sits between the edge locations and the origin Server\nlike (Your s3 bucket , EC2 or Website backend)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This sits between the edge locations and the origin Server\nlike (Your s3 bucket , EC2 or Website backend)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "PhsWkmCELpnNrdzx8q1x4",
      "type": "text",
      "x": 2915.204842204621,
      "y": 43107.9071562211,
      "width": 1366.199951171875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Gt",
      "roundness": null,
      "seed": 646469341,
      "version": 813,
      "versionNonce": 1429075997,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "These are bigger caches that edge locations and serve multiple nearby\nedge locations",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "These are bigger caches that edge locations and serve multiple nearby\nedge locations",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ZFJ2XGf4fvqrJGDiMSK2j",
      "type": "text",
      "x": 2929.204842204621,
      "y": 43235.9071562211,
      "width": 1425.5999755859375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Gu",
      "roundness": null,
      "seed": 74675005,
      "version": 975,
      "versionNonce": 1457710131,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "If an edge location dosen't have the content , it asks the regional edge\ninstead of hitting your origin server immediately .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If an edge location dosen't have the content , it asks the regional edge\ninstead of hitting your origin server immediately .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
