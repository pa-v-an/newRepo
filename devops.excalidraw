      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "Task\n1.create two users user1 and user2\n2.create a folder named india in user1\n3.create a folder named usa in user2\n4. inside india create a.txt (add some contents)\n5. inside usa create b.txt (add some contents )\nobjective : you should be able to read a.txt by being user2\n        and you should be able to write b.txt by being user1",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Task\n1.create two users user1 and user2\n2.create a folder named india in user1\n3.create a folder named usa in user2\n4. inside india create a.txt (add some contents)\n5. inside usa create b.txt (add some contents )\nobjective : you should be able to read a.txt by being user2\n        and you should be able to write b.txt by being user1",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
