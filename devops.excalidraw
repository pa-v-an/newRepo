    {
      "id": "ajrDp5TboeH63t_VTzgUA",
      "type": "text",
      "x": 2085.5420615635358,
      "y": -42213.5684548999,
      "width": 980.0333251953125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0zl",
      "roundness": null,
      "seed": 339393309,
      "version": 244,
      "versionNonce": 782731325,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> user management refers to the managing of the users in an effective \nmanner which are present within the machine. so that multiple users can\n use the system independently without interfering",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> user management refers to the managing of the users in an effective \nmanner which are present within the machine. so that multiple users can\n use the system independently without interfering",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "uFXtlitQebDKjp0hyy76Q",
      "type": "text",
      "x": 2091.4118531507174,
      "y": -42049.51845718912,
      "width": 851.2000122070312,
      "height": 140,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0zm",
      "roundness": null,
      "seed": 248467325,
      "version": 224,
      "versionNonce": 396486163,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> Why do we need user management\n  - Security : Not everyone can modify system files\n  - Separation : Everyone gets there own files and settings\n  - Control : Admins can control what users are allowed to do ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Why do we need user management\n  - Security : Not everyone can modify system files\n  - Separation : Everyone gets there own files and settings\n  - Control : Admins can control what users are allowed to do ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ylMTKDG86Cl5vqOWeaWm5",
      "type": "text",
      "x": 2107.8472695948203,
