    },
    {
      "id": "Yddx_eUA6C8892f8QcE5Z",
      "type": "text",
      "x": 3060.6059624172212,
      "y": -259.6207927648793,
      "width": 638,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
