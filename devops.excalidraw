      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> Absolute - An absolute path specifies the full location of a file or a directory from\n               the top level directory of the file system.\n                it always starts with (/)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Absolute - An absolute path specifies the full location of a file or a directory from\n               the top level directory of the file system.\n                it always starts with (/)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "N1Ftv3yo29F_nQg76wuti",
      "type": "text",
      "x": -6725.8761938770795,
      "y": -54114.30250413109,
      "width": 880,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1JZ",
      "roundness": null,
      "seed": 1814486941,
      "version": 341,
      "versionNonce": 1228642941,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> Relative - A Relative path specifies the path with respect to current location\n                . (Single dot) - Represents Current Directory\n                .. (Double dot) - Which represents the parent directory\n                ~  (tilde) - represents the home directory of a user",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Relative - A Relative path specifies the path with respect to current location\n                . (Single dot) - Represents Current Directory\n                .. (Double dot) - Which represents the parent directory\n                ~  (tilde) - represents the home directory of a user",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
