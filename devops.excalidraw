      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "A Hypervisor is a software that sits between the hardware and the Virtual Machines .\n\nIt Partiones/allocates CPU , memory and storage from the Physical Host to \nmultiple VMs .",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Hypervisor is a software that sits between the hardware and the Virtual Machines .\n\nIt Partiones/allocates CPU , memory and storage from the Physical Host to \nmultiple VMs .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
