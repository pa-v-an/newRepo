      "roundness": null,
      "seed": 1232537885,
      "version": 236,
      "versionNonce": 1574735677,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "It comes under a category caleed as security \n, Identity and Compliance .\nIam is used to manage all the permissions between the services and the\nresources .\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It comes under a category caleed as security \n, Identity and Compliance .\nIam is used to manage all the permissions between the services and the\nresources .\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
