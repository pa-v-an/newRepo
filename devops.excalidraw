      "versionNonce": 1700560157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Cherrypick allows us to select and apply a specific commit from one branch to another.\nunlike merging or rebase , it only picks the changes from a single commit (or a range of commits)\nwithout bringing the entire branch history.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cherrypick allows us to select and apply a specific commit from one branch to another.\nunlike merging or rebase , it only picks the changes from a single commit (or a range of commits)\nwithout bringing the entire branch history.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
