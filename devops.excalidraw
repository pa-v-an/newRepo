    },
    {
      "id": "pxkvN7FAYc0yzmhjsFkLP",
      "type": "text",
      "x": 2809.183401044693,
      "y": 42661.96548955439,
      "width": 1366.199951171875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Gn",
      "roundness": null,
      "seed": 66859165,
      "version": 654,
      "versionNonce": 504287997,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "They are not for computing but for content delivery (CDN) and caching",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "They are not for computing but for content delivery (CDN) and caching",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "hCS7UijYwqE6283_ICfbh",
      "type": "text",
      "x": 2809.516734378025,
      "y": 42744.96548955439,
      "width": 1188,
      "height": 45,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Go",
      "roundness": null,
      "seed": 1103500541,
      "version": 766,
      "versionNonce": 758753107,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Used by Amazon Cloudfront to deliver data with low latency .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Used by Amazon Cloudfront to deliver data with low latency .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "liB5pLhba-Kd5iUtBKB-x",
      "type": "text",
      "x": 2804.6071853915,
      "y": 42818.67382288768,
      "width": 1603.800048828125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Gp",
      "roundness": null,
      "seed": 160722269,
      "version": 702,
      "versionNonce": 437611357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "E.g.. if a user in Bangalore requests for your website , data is delivered\n from the nearest Bangalore edge location , not all the way from mumbai (Origin).",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E.g.. if a user in Bangalore requests for your website , data is delivered\n from the nearest Bangalore edge location , not all the way from mumbai (Origin).",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
