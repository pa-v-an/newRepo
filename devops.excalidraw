      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Squash is a git feature that allows the combining of multiple sequential commits into a single commit.\n\"its like squashing multiple sequential commits into one\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Squash is a git feature that allows the combining of multiple sequential commits into a single commit.\n\"its like squashing multiple sequential commits into one\"",
