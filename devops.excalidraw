      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> 1969 - UNIX  (ken Thompson and Dennis Ritche)\n> 1983 - GNU (GNU's not unix) Richard Stallman\n> 1991 - linus torvald (Freax)\n> 1992 - Linux operating system (Open Source)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> 1969 - UNIX  (ken Thompson and Dennis Ritche)\n> 1983 - GNU (GNU's not unix) Richard Stallman\n> 1991 - linus torvald (Freax)\n> 1992 - Linux operating system (Open Source)",
