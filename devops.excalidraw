      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "Task \n- Create a new user name \"user1\"\n- set the default shell of user as sh\n- don't create a home directory for the user1\n-switch to root user\n- create another user named user2\n- create a file in user2's home directory\n-try to access it becoming user1\n- delete the user2 but not the home directory\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Task \n- Create a new user name \"user1\"\n- set the default shell of user as sh\n- don't create a home directory for the user1\n-switch to root user\n- create another user named user2\n- create a file in user2's home directory\n-try to access it becoming user1\n- delete the user2 but not the home directory\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
