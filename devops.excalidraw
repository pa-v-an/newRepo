      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "1. Create 2 users. (user10.... user20)\n2. under both users create 2 folders\n3. Inside both folders create 3 text files\n4. By acting as user 2 try writing content inside one of the texts\nfiles present under user1 and vice versa",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Create 2 users. (user10.... user20)\n2. under both users create 2 folders\n3. Inside both folders create 3 text files\n4. By acting as user 2 try writing content inside one of the texts\nfiles present under user1 and vice versa",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
