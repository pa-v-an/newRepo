      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "A VPC is a private , isolated virtual network inside AWS , where we can launch and control our\nAWS resources .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A VPC is a private , isolated virtual network inside AWS , where we can launch and control our\nAWS resources .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "LxHGzrbO95GHooMbEdxit",
      "type": "text",
      "x": 2896.0756099876435,
      "y": 60628.43770726949,
      "width": 851.4000244140625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Tx",
      "roundness": null,
      "seed": 332219037,
      "version": 682,
      "versionNonce": 1077001213,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Its like our own private network inside AWS",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its like our own private network inside AWS",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "BDPqye3mwkG6hrP-jPHnS",
      "type": "text",
      "x": 2896.0756099876435,
      "y": 60748.43770726949,
      "width": 2039.4000244140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2Ty",
      "roundness": null,
      "seed": 430237437,
      "version": 849,
      "versionNonce": 1641401939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "In AWS , every region will have a default VPC , Inside which all the resources inside a specific region\nwill be actually created or present .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In AWS , every region will have a default VPC , Inside which all the resources inside a specific region\nwill be actually created or present .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
