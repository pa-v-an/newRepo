    },
    {
      "id": "l777hON9Dl6uZXC4TD60Z",
      "type": "text",
      "x": -6268.11733458207,
      "y": -47046.66209319779,
      "width": 792,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1XO",
      "roundness": null,
      "seed": 2100819197,
      "version": 290,
      "versionNonce": 799520595,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> Collection of multiple users\n> Groups are used to control access to files , folders and commands.\n  Instead of giving permissions to each user one by one , we assign the \n  permissions to a group, and users present in that group will\n  automatically inherit the permission.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Collection of multiple users\n> Groups are used to control access to files , folders and commands.\n  Instead of giving permissions to each user one by one , we assign the \n  permissions to a group, and users present in that group will\n  automatically inherit the permission.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "SIWkW27I52BkRJ-d6ouAf",
      "type": "text",
      "x": -6250.844607309342,
      "y": -46881.07118410688,
      "width": 165,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1XP",
      "roundness": null,
      "seed": 1003113821,
      "version": 21,
      "versionNonce": 1230003037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "Types of Groups",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of Groups",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "daFi3M5YjJZerCo67mnSL",
      "type": "text",
      "x": -6250.844607309342,
      "y": -46832.88936592506,
      "width": 803,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1XQ",
      "roundness": null,
      "seed": 993171901,
      "version": 489,
      "versionNonce": 1996182771,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> Primary Group - When a user is created , it is automatically assigned\n                  with a group by default , which is usually the same \n                  as user ID. This group is called the primary group of \n                  the user .\n                  Every user will have exactly one primary group.\n> Secondary Group - Additional groups where we can add users and can be \n                    further used to grant access to the shared resources.\n                    A user can be part of multiple secondary groups.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Primary Group - When a user is created , it is automatically assigned\n                  with a group by default , which is usually the same \n                  as user ID. This group is called the primary group of \n                  the user .\n                  Every user will have exactly one primary group.\n> Secondary Group - Additional groups where we can add users and can be \n                    further used to grant access to the shared resources.\n                    A user can be part of multiple secondary groups.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "vcKoDj55KJioAeTqHXXgy",
      "type": "text",
      "x": -6169.662789127524,
      "y": -46573.616638652355,
      "width": 660,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1XR",
      "roundness": null,
      "seed": 1418877469,
      "version": 229,
      "versionNonce": 147253181,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "#Whenever a file/folder is created , linux tags it with \n two things ->\n> owner -> the owner of the file/folder\n> group -> the group owner of the file/directory , which is \n           generally the primary group of the user .",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#Whenever a file/folder is created , linux tags it with \n two things ->\n> owner -> the owner of the file/folder\n> group -> the group owner of the file/directory , which is \n           generally the primary group of the user .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
