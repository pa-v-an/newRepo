      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "1. Create a Group named  \" S3Admins \"\n2. Create 2 IAM users named  \" user1 \" and \" user2 \"\n3. Add the users to the group\n4. Give the users access to S3 by using Groups\n5. Log in as IAM users and check if its working or not\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Create a Group named  \" S3Admins \"\n2. Create 2 IAM users named  \" user1 \" and \" user2 \"\n3. Add the users to the group\n4. Give the users access to S3 by using Groups\n5. Log in as IAM users and check if its working or not\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
