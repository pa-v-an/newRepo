    },
    {
      "id": "jBoDs-nRwnvUJBHUelt9g",
      "type": "text",
      "x": 2351.863948719094,
      "y": -37598.13989875416,
      "width": 734.5999755859375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c13s",
      "roundness": null,
      "seed": 1345944253,
      "version": 259,
      "versionNonce": 2019277939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": ">> Primary Group - Whenever a user is created , it is assigned with a group\n                        by default , which is usually the same as the UID .\n                        This group is called Primary group .\n// There can be only one primary group for a user.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ">> Primary Group - Whenever a user is created , it is assigned with a group\n                        by default , which is usually the same as the UID .\n                        This group is called Primary group .\n// There can be only one primary group for a user.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "k_RiFJG5qMMQmlL9esejM",
      "type": "text",
      "x": 2352.7487564813346,
      "y": -37459.22508008224,
      "width": 769,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c13t",
      "roundness": null,
      "seed": 1209342749,
      "version": 354,
      "versionNonce": 430094397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": ">> Secondary Group - Additiolal groups where we can add users and can be \n                            further used to grant access to the shared resources .\n                            \n// There can be 'n' number of secondary group for a user .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ">> Secondary Group - Additiolal groups where we can add users and can be \n                            further used to grant access to the shared resources .\n                            \n// There can be 'n' number of secondary group for a user .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
