      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "> it is a way of organizing and storing the files on the\n machine\n# In linux , Everything is treated as a file ,\n(folders/directories) ...\nfolders/directories are just special kind of files\nwhich has the capability to store other files or \nmultiple files inside it .",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> it is a way of organizing and storing the files on the\n machine\n# In linux , Everything is treated as a file ,\n(folders/directories) ...\nfolders/directories are just special kind of files\nwhich has the capability to store other files or \nmultiple files inside it .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
