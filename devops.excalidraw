      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "Anywhere throughout the AWS , if permissions is required we need to configure \nIAM .t",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Anywhere throughout the AWS , if permissions is required we need to configure \nIAM .t",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "UkpbwITRe4GyERhOiOQO1",
      "type": "text",
      "x": 577.1971099354796,
      "y": -60291.4106781391,
      "width": 1078,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
