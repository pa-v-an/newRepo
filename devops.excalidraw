      "boundElements": [],
      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "eg:\n    grep \"error\" /var/log/auth.log\n    grep -i \"hello\" file.txt // -i > case - insensitive search\n    grep -r \"password\" /etc // recursive search in directory",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "eg:\n    grep \"error\" /var/log/auth.log\n    grep -i \"hello\" file.txt // -i > case - insensitive search\n    grep -r \"password\" /etc // recursive search in directory",
      "autoResize": true,
