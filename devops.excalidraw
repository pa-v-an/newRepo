    {
      "id": "1J1L377zLUmLYDp2uJ6oC",
      "type": "text",
      "x": 3258.517703389718,
      "y": 49397.15984032815,
      "width": 1504.800048828125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
