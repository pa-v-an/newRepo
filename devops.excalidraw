      "updated": 1775719920838,
      "link": null,
      "locked": false,
      "text": "user(owner)          u        (The owner of the file)\ngroup                  g        (Users who are in the same group)\nother                  o       (Everyone else (neither the owner , nor present in the group)\nall                      a        (Applies to all (Users + group + others)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "user(owner)          u        (The owner of the file)\ngroup                  g        (Users who are in the same group)\nother                  o       (Everyone else (neither the owner , nor present in the group)\nall                      a        (Applies to all (Users + group + others)",
      "autoResize": true,
