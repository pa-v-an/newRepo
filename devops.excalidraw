      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "each AZ will have one or more data centers with its own \npower , cooling and networking .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "each AZ will have one or more data centers with its own \npower , cooling and networking .",
