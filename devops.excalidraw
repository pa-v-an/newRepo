    {
      "id": "JT8Nyjy5GseLPSSPCOKhu",
      "type": "text",
      "x": 3021.5614401440307,
      "y": 53521.42249109983,
      "width": 1603.800048828125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2O4",
      "roundness": null,
      "seed": 787734973,
      "version": 1188,
      "versionNonce": 586838259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Nginx runs as a background service (daemon) -> It listens to port 80 (HTTP) ( and\n443 for https if configured )",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nginx runs as a background service (daemon) -> It listens to port 80 (HTTP) ( and\n443 for https if configured )",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "m6Q2aQgmJh93Sn8_7g7pw",
      "type": "text",
      "x": 3024.8947734773647,
      "y": 53624.755824433174,
      "width": 1584,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2O5",
      "roundness": null,
      "seed": 1357554205,
      "version": 1304,
      "versionNonce": 1960283069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "So , whenever a request comes for the respective IP , it provides a appropriate \nresponse",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So , whenever a request comes for the respective IP , it provides a appropriate \nresponse",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
