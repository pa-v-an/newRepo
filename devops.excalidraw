      "isDeleted": false,
      "boundElements": [],
      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "Availability zones are like physical locations of our \ndata centers (Cluster of Independent Data Centers) .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Availability zones are like physical locations of our \ndata centers (Cluster of Independent Data Centers) .",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
