      "link": null,
      "locked": false,
      "text": "Relative Path - A relative path specifies the path with reference to the\n                current location .\n                . (Single Dot) - represents the Current Directory.\n                .. (double Dot) - Represents the Parent Directory.\n                ~ (Tilde) - It represents the Users Home Directory . ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
