    {
      "id": "xJn_YzXagR_7QoV5Oept1",
      "type": "text",
      "x": -6940.038182884509,
      "y": -57226.63401124956,
      "width": 184.8000030517578,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
