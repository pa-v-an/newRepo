      "updated": 1775719920839,
      "link": null,
      "locked": false,
      "text": "The git fecth command retrives the latest changes from the remote repository , without modifying\nour working Directory .\nIt helps us to inspect updates before integrating them with git merge or git rebase .",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The git fecth command retrives the latest changes from the remote repository , without modifying\nour working Directory .\nIt helps us to inspect updates before integrating them with git merge or git rebase .",
      "autoResize": true,
