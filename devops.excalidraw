      "text": "> grep (Global regular expression Print)\n  search for the specified pattern in the text\n  # its a powerful \"find the text\" tool\n  # Returns all the lines with the specified pattern or keyword",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> grep (Global regular expression Print)\n  search for the specified pattern in the text\n  # its a powerful \"find the text\" tool\n  # Returns all the lines with the specified pattern or keyword",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
